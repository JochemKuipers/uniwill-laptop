# Uniwill sysfs is 644 root; chmod after the driver binds and LEDs appear.
ACTION=="bind", SUBSYSTEM=="platform", KERNEL=="INOU0000:*", RUN+="/bin/sh -c 'for f in fn_lock super_key_enable touchpad_toggle_enable rainbow_animation breathing_in_suspend ctgp_offset usb_c_power_priority ac_auto_boot usb_powershare_high; do p=/sys/devices/platform/%k/$f; [ -e \"$p\" ] && chgrp plugdev \"$p\" && chmod 664 \"$p\"; done'"
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="uniwill:*", RUN+="/bin/sh -c 'for f in brightness multi_intensity; do p=/sys/class/leds/%k/$f; [ -e \"$p\" ] && chgrp plugdev \"$p\" && chmod 664 \"$p\"; done'"
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="uniwill", RUN+="/bin/sh -c 'for f in /sys/class/hwmon/%k/pwm1 /sys/class/hwmon/%k/pwm2 /sys/class/hwmon/%k/pwm1_enable /sys/class/hwmon/%k/pwm2_enable; do [ -e \"$f\" ] && chgrp plugdev \"$f\" && chmod 664 \"$f\"; done'"
