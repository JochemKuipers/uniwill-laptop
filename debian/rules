#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --sourcedirectory=control --builddirectory=debian/build-control

override_dh_auto_build:
	dh_auto_build --builddirectory=debian/build-control

override_dh_auto_install:
	dh_auto_install --builddirectory=debian/build-control --destdir=debian/uniwill-control

override_dh_auto_clean:
	dh_auto_clean --builddirectory=debian/build-control
	rm -rf debian/build-control

# Ubuntu 24.04 uses *t64 Qt package names; Debian/PikaOS 6.10 uses
# libqt6gui6 / libqt6widgets6. Keep both as ORs in debian/control.
override_dh_shlibdeps:
	dh_shlibdeps -- \
		-xlibqt6core6t64 -xlibqt6core6 \
		-xlibqt6gui6t64 -xlibqt6gui6 \
		-xlibqt6widgets6t64 -xlibqt6widgets6
